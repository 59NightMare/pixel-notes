# Required for production canonical URLs, RSS, Sitemap and Open Graph images.
SITE_URL=https://your-domain.example

# Optional integrations. Features show a clear setup state when omitted.
PUBLIC_BUTTONDOWN_USERNAME=
# Leave empty when Cloudflare Web Analytics automatic injection is enabled.
PUBLIC_CF_WEB_ANALYTICS_TOKEN=
PUBLIC_GISCUS_REPO=owner/repository
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
