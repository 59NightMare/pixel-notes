---
import '@pixelium/web-vue/dist/pixelium-vue.css'
import '@pixelium/web-vue/dist/font.css'
import '@pixelium/web-vue/dist/normalize.css'
import '../../styles.css'
import BrandMark from '../components/BrandMark.astro'
import HeaderActions from '../components/HeaderActions.vue'
import BackTopControl from '../components/BackTopControl.vue'
import NewsletterForm from '../components/NewsletterForm.vue'
import ReadingProgress from '../components/ReadingProgress.vue'
import ConnectionStatus from '../components/ConnectionStatus.vue'
import { Link as PixelLink } from '@pixelium/web-vue'

interface Props { title: string; description: string; current?: 'home' | 'article'; canonical?: string; ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article'; lang?: 'zh-CN' | 'en'; alternatePath?: string }
const { title, description, current = 'home', ogImage = '/images/og/default.png', ogImageAlt = 'Pixel Notes 像素风分享封面', ogType = 'website', lang = 'zh-CN', alternatePath } = Astro.props
const Link: any = PixelLink
const isEnglish = lang === 'en'
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const alternate = alternatePath ? new URL(alternatePath, Astro.site ?? Astro.url.origin) : undefined
const shareImage = new URL(ogImage, Astro.site ?? Astro.url.origin)
const buttondownUsername = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN
const languageTarget = alternatePath ?? (isEnglish ? '/' : '/en/')
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isCurrent = (href: string) => {
  const target = href.replace(/\/+$/, '') || '/'
  return target === '/' || target === '/en'
    ? pathname === target
    : pathname === target || pathname.startsWith(`${target}/`)
}
---
<!doctype html>
<html lang={lang}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="canonical" href={canonical} />{alternate && <link rel="alternate" hreflang={isEnglish ? 'zh-CN' : 'en'} href={alternate} />}<link rel="alternate" type="application/rss+xml" title="Pixel Notes RSS" href="/rss.xml" /><meta property="og:locale" content={isEnglish ? 'en_US' : 'zh_CN'} /><meta property="og:site_name" content="Pixel Notes" /><meta property="og:type" content={ogType} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={ogImageAlt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={ogImageAlt} /><link rel="manifest" href="/manifest.webmanifest" /><meta name="theme-color" content="#fffaf0" /><script is:inline>let initialTheme=window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';try{const storedTheme=localStorage.getItem('pixel-notes-theme');if(storedTheme==='light'||storedTheme==='dark')initialTheme=storedTheme}catch{}document.documentElement.classList.add(initialTheme);document.querySelector('meta[name="theme-color"]')?.setAttribute('content',initialTheme==='dark'?'#171923':'#fffaf0');</script><title>{title}</title>{analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${analyticsToken}"}`}></script>}</head>
  <body>
    {current === 'article' && <ReadingProgress client:load />}
    <a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : '跳至正文'}</a>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href={isEnglish ? '/en/' : '/'} aria-label="Pixel Notes"><BrandMark /><span class="brand-wordmark"><strong><span>PIXEL</span><i aria-hidden="true">/</i><span>NOTES</span></strong><small>{isEnglish ? 'PIXEL JOURNAL' : '像素笔记'}</small></span></a>
      <nav class="desktop-nav" aria-label={isEnglish ? 'Main navigation' : '主导航'} data-pagefind-ignore>{isEnglish ? <><a href="/en/" aria-current={isCurrent('/en/') ? 'page' : undefined}>Home</a><a href="/en/archive/" aria-current={isCurrent('/en/archive/') ? 'page' : undefined}>Archive</a><a href="/en/about/" aria-current={isCurrent('/en/about/') ? 'page' : undefined}>About</a></> : <><a href="/" aria-current={isCurrent('/') ? 'page' : undefined}>首页</a><a href="/archive/" aria-current={isCurrent('/archive/') ? 'page' : undefined}>归档</a><a href="/categories/" aria-current={isCurrent('/categories/') ? 'page' : undefined}>分类</a><a href="/tags/" aria-current={isCurrent('/tags/') ? 'page' : undefined}>标签</a><a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>关于</a></>}</nav>
      <div class="header-tools"><a class="language-switch" href={languageTarget} hreflang={isEnglish ? 'zh-CN' : 'en'} aria-label={isEnglish ? '切换到中文' : 'Switch to English'}><strong>{isEnglish ? '中' : 'EN'}</strong><small>{isEnglish ? 'EN' : '中'}</small></a><HeaderActions client:load lang={isEnglish ? 'en' : 'zh'} languageHref={languageTarget} /></div>
    </div></header>
    <slot />
    <footer id="about" class="site-footer" data-pagefind-ignore><div class="container">{!isEnglish && <NewsletterForm client:load username={buttondownUsername} compact />}<div class="footer-grid"><div><strong class="brand">PIXEL NOTES</strong><p>{isEnglish ? 'Written and maintained by A-Che in Shanghai.' : '由阿澈在上海持续写作与维护。'}</p></div><nav class="footer-links" aria-label={isEnglish ? 'Footer navigation' : '页脚导航'}><Link href={isEnglish ? '/en/archive/' : '/archive/'}>{isEnglish ? 'Archive' : '归档'}</Link><Link href="/rss.xml">RSS</Link><Link href="/privacy/">{isEnglish ? 'Privacy' : '隐私'}</Link><Link href="/admin/">CMS</Link></nav></div></div></footer>
    <BackTopControl client:load />
    <ConnectionStatus client:load />
    <script is:inline>if ('serviceWorker' in navigator) window.addEventListener('load', () => navigator.serviceWorker.register('/service-worker.js'))</script>
  </body>
</html>
