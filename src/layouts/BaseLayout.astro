---
import '@pixelium/web-vue/dist/pixelium-vue.css'
import '@pixelium/web-vue/dist/font.css'
import '@pixelium/web-vue/dist/normalize.css'
import '../../styles.css'
import BrandMark from '../components/BrandMark.astro'
import HeaderActions from '../components/HeaderActions.vue'
import BackTopControl from '../components/BackTopControl.vue'
import NewsletterForm from '../components/NewsletterForm.vue'
import { Link as PixelLink } from '@pixelium/web-vue'

interface Props { title: string; description: string; current?: 'home' | 'article'; canonical?: string; ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article'; lang?: 'zh-CN' | 'en'; alternatePath?: string }
const { title, description, current = 'home', ogImage = '/images/og/default.png', ogImageAlt = 'Pixel Notes 像素风分享封面', ogType = 'website', lang = 'zh-CN', alternatePath = '/en/' } = Astro.props
const Link: any = PixelLink
const isEnglish = lang === 'en'
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const alternate = new URL(alternatePath, Astro.site ?? Astro.url.origin)
const shareImage = new URL(ogImage, Astro.site ?? Astro.url.origin)
const newsletterAction = import.meta.env.PUBLIC_NEWSLETTER_ACTION
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN
---
<!doctype html>
<html lang={lang}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="alternate" hreflang={isEnglish ? 'zh-CN' : 'en'} href={alternate} /><link rel="alternate" type="application/rss+xml" title="Pixel Notes RSS" href="/rss.xml" /><meta property="og:locale" content={isEnglish ? 'en_US' : 'zh_CN'} /><meta property="og:site_name" content="Pixel Notes" /><meta property="og:type" content={ogType} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={ogImageAlt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={ogImageAlt} /><link rel="manifest" href="/manifest.webmanifest" /><meta name="theme-color" content="#fffaf0" /><title>{title}</title>{analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token":"${analyticsToken}"}`}></script>}</head>
  <body>
    <a class="skip-link" href="#main">{isEnglish ? 'Skip to content' : '跳至正文'}</a>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href={isEnglish ? '/en/' : '/'} aria-label="Pixel Notes"><BrandMark /><span>PIXEL NOTES</span></a>
      <nav class="desktop-nav" aria-label={isEnglish ? 'Main navigation' : '主导航'} data-pagefind-ignore>{isEnglish ? <><a href="/en/" aria-current={current === 'home' ? 'page' : undefined}>Home</a><a href="/en/archive/">Archive</a><a href="/en/about/">About</a></> : <><a href="/" aria-current={current === 'home' ? 'page' : undefined}>首页</a><a href="/archive/">归档</a><a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/about/">关于</a></>}</nav>
      <a class="language-switch" href={alternatePath} hreflang={isEnglish ? 'zh-CN' : 'en'}>{isEnglish ? '中' : 'EN'}</a>
      <HeaderActions client:load lang={isEnglish ? 'en' : 'zh'} />
    </div></header>
    <slot />
    <footer id="about" class="site-footer" data-pagefind-ignore><div class="container">{!isEnglish && <NewsletterForm client:load action={newsletterAction} compact />}<div class="footer-grid"><div><strong class="brand">PIXEL NOTES</strong><p>{isEnglish ? 'Written and maintained by A-Che in Shanghai.' : '由阿澈在上海持续写作与维护。'}</p></div><nav class="footer-links" aria-label={isEnglish ? 'Footer navigation' : '页脚导航'}><Link href={isEnglish ? '/en/archive/' : '/archive/'}>{isEnglish ? 'Archive' : '归档'}</Link><Link href="/rss.xml">RSS</Link><Link href="/privacy/">{isEnglish ? 'Privacy' : '隐私'}</Link><Link href="/admin/">CMS</Link></nav></div></div></footer>
    <BackTopControl client:load />
  </body>
</html>
