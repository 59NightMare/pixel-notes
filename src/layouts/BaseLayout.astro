---
import '@pixelium/web-vue/dist/pixelium-vue.css'
import '@pixelium/web-vue/dist/font.css'
import '@pixelium/web-vue/dist/normalize.css'
import '../../styles.css'
import BrandMark from '../components/BrandMark.astro'
import HeaderActions from '../components/HeaderActions.vue'
import BackTopControl from '../components/BackTopControl.vue'
import { Link as PixelLink } from '@pixelium/web-vue'

interface Props { title: string; description: string; current?: 'home' | 'article'; canonical?: string; ogImage?: string; ogImageAlt?: string; ogType?: 'website' | 'article' }
const { title, description, current = 'home', ogImage = '/images/og/default.png', ogImageAlt = 'Pixel Notes 像素风分享封面', ogType = 'website' } = Astro.props
const Link: any = PixelLink
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const shareImage = new URL(ogImage, Astro.site ?? Astro.url.origin)
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><link rel="canonical" href={canonical} /><link rel="alternate" type="application/rss+xml" title="Pixel Notes RSS" href="/rss.xml" /><meta property="og:locale" content="zh_CN" /><meta property="og:site_name" content="Pixel Notes" /><meta property="og:type" content={ogType} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content={shareImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={ogImageAlt} /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={shareImage} /><meta name="twitter:image:alt" content={ogImageAlt} /><title>{title}</title></head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href="/" aria-label="Pixel Notes 首页"><BrandMark /><span>PIXEL NOTES</span></a>
      <nav class="desktop-nav" aria-label="主导航" data-pagefind-ignore><a href="/" aria-current={current === 'home' ? 'page' : undefined}>首页</a><a href="/archive/">归档</a><a href="/categories/">分类</a><a href="/tags/">标签</a><a href="/about/">关于</a></nav>
      <HeaderActions client:load />
    </div></header>
    <slot />
    <footer id="about" class="site-footer" data-pagefind-ignore><div class="container footer-grid"><div><strong class="brand">PIXEL NOTES</strong><p>由阿澈在上海持续写作与维护。</p></div><nav class="footer-links" aria-label="页脚导航"><Link href="/archive/">归档</Link><Link href="/categories/">主题</Link><Link href="/rss.xml">RSS</Link><Link href="https://github.com/">GitHub</Link></nav></div></footer>
    <BackTopControl client:load />
  </body>
</html>
