---
interface Props {
  repo?: string
  repoId?: string
  category?: string
  categoryId?: string
}

const { repo, repoId, category, categoryId } = Astro.props
const enabled = Boolean(repo && repoId && category && categoryId)
---
<section class="comments" aria-labelledby="comments-title" data-pagefind-ignore>
  <div class="section-head"><div><div class="pixel-label">DISCUSSION</div><h2 id="comments-title">评论与讨论</h2></div></div>
  {enabled ? (
    <script is:inline src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="zh-CN"
      data-loading="lazy"
      crossorigin="anonymous"
      async></script>
  ) : (
    <div class="service-note"><strong>评论通道待配置</strong><p>启用后使用 GitHub Discussions 登录、举报与审核，不在本站保存账号资料。</p></div>
  )}
</section>
