---
interface Props {
  repo?: string
  repoId?: string
  category?: string
  categoryId?: string
  lang?: 'zh' | 'en'
}

const { repo, repoId, category, categoryId, lang = 'zh' } = Astro.props
const enabled = Boolean(repo && repoId && category && categoryId)
const isEnglish = lang === 'en'
---
<section class="comments" aria-labelledby="comments-title" data-pagefind-ignore>
  <div class="section-head"><div><div class="pixel-label">DISCUSSION</div><h2 id="comments-title">{isEnglish ? 'Comments & discussion' : '评论与讨论'}</h2></div></div>
  {enabled ? (
    <script is:inline src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang={isEnglish ? 'en' : 'zh-CN'}
      data-loading="lazy"
      crossorigin="anonymous"
      async></script>
  ) : (
    <div class="service-note"><strong>{isEnglish ? 'Comments are not configured yet' : '评论通道待配置'}</strong><p>{isEnglish ? 'Once enabled, GitHub Discussions handles sign-in, reporting, and moderation. This site stores no account profiles.' : '启用后使用 GitHub Discussions 登录、举报与审核，不在本站保存账号资料。'}</p></div>
  )}
</section>
{enabled && <script is:inline>
  const syncPixelNotesGiscusTheme = () => {
    const frame = document.querySelector('iframe.giscus-frame')
    const theme = document.documentElement.classList.contains('dark') ? 'transparent_dark' : 'light'
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app')
    return Boolean(frame)
  }
  new MutationObserver(syncPixelNotesGiscusTheme).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
  const giscusLoader = new MutationObserver(() => {
    if (syncPixelNotesGiscusTheme()) giscusLoader.disconnect()
  })
  giscusLoader.observe(document.body, { childList: true, subtree: true })
  window.addEventListener('load', syncPixelNotesGiscusTheme, { once: true })
</script>}
