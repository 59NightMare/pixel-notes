---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ListingContent from '../../components/ListingContent.vue'
import { orderedCounts, serializePost, sortPosts } from '../../lib/posts'
import { tags } from '../../config/taxonomy'
const entries = sortPosts(await getCollection('posts', ({ data }) => !data.draft))
const posts = entries.map(serializePost)
const filters = orderedCounts(entries.flatMap((post) => post.data.tags), tags).map((item) => ({ ...item, href: `/tags/${encodeURIComponent(item.label)}/` }))
---
<BaseLayout title="文章标签 - Pixel Notes" description="按标签浏览 Pixel Notes。"><ListingContent eyebrow="TAGS" title="文章标签" description="标签是文章之间更细粒度的连接。" posts={posts} filters={filters} filterType="tag" totalCount={posts.length} /></BaseLayout>
