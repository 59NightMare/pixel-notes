---
import type { CollectionEntry } from 'astro:content'
import { getCollection, render } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import ArticleContent from '../../components/ArticleContent.vue'
import Comments from '../../components/Comments.astro'
import { serializePost, sortPosts } from '../../lib/posts'

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft))
  return posts.map((post, index) => ({ params: { id: post.id }, props: { post, previous: posts[index + 1] ?? null, next: posts[index - 1] ?? null } }))
}

interface Props { post: CollectionEntry<'posts'>; previous: CollectionEntry<'posts'> | null; next: CollectionEntry<'posts'> | null }
const { post, previous, next } = Astro.props
const { Content, headings } = await render(post)
const article = serializePost(post)
const comments = {
  repo: import.meta.env.PUBLIC_GISCUS_REPO,
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID,
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY,
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
}
---
<BaseLayout current="article" title={`${post.data.title} - Pixel Notes`} description={post.data.summary} ogImage={post.data.ogImage} ogImageAlt={post.data.coverAlt} ogType="article" alternatePath={`/en/posts/${post.id}/`}>
  <ArticleContent client:load post={article} headings={headings} previous={previous ? { id: previous.id, title: previous.data.title } : null} next={next ? { id: next.id, title: next.data.title } : null}>
    <Content />
  </ArticleContent>
  <div class="container comments-shell"><Comments {...comments} /></div>
</BaseLayout>
