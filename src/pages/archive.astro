---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import ListingContent from '../components/ListingContent.vue'
import { serializePost, sortPosts } from '../lib/posts'
const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft)).map(serializePost)
---
<BaseLayout title="文章归档 - Pixel Notes" description="按发布时间浏览 Pixel Notes 的全部文章。"><ListingContent client:load eyebrow="ARCHIVE" title="文章归档" description={`目前共有 ${posts.length} 篇文章，按发布时间从新到旧排列。`} posts={posts} /></BaseLayout>
